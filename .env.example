# Copy this file to .env and fill it in. .env is git-ignored - never commit it.

# demo = built-in fake Home Assistant (no HA needed). live = your real Home Assistant.
HA_MODE=demo

# --- live mode only ---
# Your Nabu Casa remote URL (Settings > Home Assistant Cloud > Remote Control), no trailing slash
HA_URL=https://xxxxxxxxxxxxxxxx.ui.nabu.casa
# Long-lived access token created under the dedicated, NON-admin "dashboard" HA user
HA_TOKEN=

# --- app security (required when NODE_ENV=production) ---
# The single password for signing in to the dashboard
APP_PASSWORD=
# Random string used to sign session cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- optional ---
PORT=3000
# Postgres (e.g. Neon). Leave empty to keep chart history in memory only.
DATABASE_URL=
